{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghjump",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    // Org used for bare `repo#123`.
    "DEFAULT_ORG": "corpname",
    // Extra orgs recognised in `org/repo` (comma-separated). DEFAULT_ORG is always included.
    "ORGS": "",
    // Where everything else goes. `{q}` is replaced by the URL-encoded query.
    "FALLBACK": "https://www.google.com/search?q={q}"
  }
}
