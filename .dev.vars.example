# Copy to .dev.vars (gitignored). Used by `pnpm dev`; `pnpm secrets` uploads it as Worker secrets.

# Org used for bare `repo#123`.
DEFAULT_ORG=acme
# Extra orgs recognised in `org/repo`, comma-separated. `alias=org` makes `alias/repo` work too.
ORGS=a=acme,rust-lang
# Where everything else goes. `{q}` is replaced by the URL-encoded query. Defaults to Google.
FALLBACK=https://www.google.com/search?q={q}
# Short repo names, `short=repo` comma-separated: `short#123` / `org/short` expand to the full repo name.
REPO_ALIASES=w=widgets,dc=dynamic-config
